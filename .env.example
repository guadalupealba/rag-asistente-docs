# Copiar este archivo como ".env" y completar con tus claves reales
# NUNCA subir el archivo ".env" real a GitHub (ya está en .gitignore)

# Clave de la API de Groq (https://console.groq.com/keys)
GROQ_API_KEY=tu_api_key_aca

# Configuración de la base de datos vectorial (completar según lo que se elija)
# Ejemplo para pgvector (PostgreSQL):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/rag_db

# Ejemplo para ChromaDB (persistencia local):
# CHROMA_PERSIST_DIR=./chroma_db

# Tamaño de chunk para el troceo de documentos (a definir/ajustar)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
